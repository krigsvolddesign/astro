---
const {href}=Astro.props;
const groups=[{title:'The language',links:[['Principles and decisions','https://krigsvolddesign.dev/design-language/'],['Pattern contracts','https://krigsvolddesign.dev/design-language/#patterns']]},{title:'Build',links:[['React reference','https://react.krigsvolddesign.dev/'],['Astro reference',href('/')],['Jekyll reference','https://jekyll.krigsvolddesign.dev/'],['Core foundations','https://krigsvolddesign.dev/design-system/'],['Astro source','https://github.com/krigsvolddesign/astro'],['MCP and builder skill','https://krigsvolddesign.dev/agents/']]},{title:'Elsewhere',links:[['James Howard','https://jameshoward.us/'],['The Count of Krigsvold','https://krigsvold.org/'],['Martlet','https://martletdesign.dev/']]},{title:'Legal',links:[['Privacy Notice','https://krigsvolddesign.dev/privacy-and-cookie-notice/'],['Cookie Settings','https://krigsvolddesign.dev/privacy-and-cookie-notice/#cookie-settings'],['Terms of Use','https://jameshoward.us/terms-of-use/'],['Copyright','https://jameshoward.us/copyright/'],['Design Licensing','https://krigsvolddesign.dev/privacy-and-cookie-notice/#copyright']]}];
---
<footer class="site-footer"><div class="container"><div class="row gy-5 gx-4 gx-lg-5"><div class="col-lg-4"><a class="footer-owner" href="https://jameshoward.us/" aria-label="James Howard website"><img class="footer-owner__badge" src={href('/assets/owner.svg')} alt="" width="58" height="58"/><span class="footer-owner__site">Krigsvold Astro</span><span class="footer-owner__byline">A website of James Howard</span></a><p class="mt-4">Components, working patterns, and agent guidance grounded in krigsvold.org.</p></div>{groups.map(group=><div class="col-6 col-md-3 col-lg-2"><h2>{group.title}</h2><ul>{group.links.map(([label,url])=><li><a href={url}>{label}</a></li>)}</ul></div>)}</div><div class="site-footer__base"><p>Copyright © 2026 James P. Howard, II</p></div></div></footer>
