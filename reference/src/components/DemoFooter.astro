---
import {SiteFooter} from '@krigsvold/astro';
const {href}=Astro.props;
const groups=[{"label": "The language", "links": [{"label": "Principles and decisions", "href": "https://krigsvolddesign.dev/design-language/"}, {"label": "Pattern contracts", "href": "https://krigsvolddesign.dev/design-language/#patterns"}]}, {"label": "Build", "links": [{"label": "React reference", "href": "https://react.krigsvolddesign.dev/"}, {"label": "Astro reference", "href": "https://astro.krigsvolddesign.dev/"}, {"label": "Jekyll reference", "href": "https://jekyll.krigsvolddesign.dev/"}, {"label": "Core foundations", "href": "https://krigsvolddesign.dev/design-system/"}, {"label": "Astro source", "href": "https://github.com/krigsvolddesign/astro"}, {"label": "MCP and builder skill", "href": "https://krigsvolddesign.dev/agents/"}]}, {"label": "Elsewhere", "links": [{"label": "James Howard", "href": "https://jameshoward.us/"}, {"label": "The Count of Krigsvold", "href": "https://krigsvold.org/"}, {"label": "Martlet", "href": "https://martletdesign.dev/"}]}, {"label": "Legal", "links": [{"label": "Privacy Notice", "href": "https://krigsvolddesign.dev/privacy-and-cookie-notice/"}, {"label": "Cookie Settings", "href": "https://krigsvolddesign.dev/privacy-and-cookie-notice/#cookie-settings"}, {"label": "Terms of Use", "href": "https://jameshoward.us/terms-of-use/"}, {"label": "Copyright", "href": "https://jameshoward.us/copyright/"}, {"label": "Design Licensing", "href": "https://krigsvolddesign.dev/privacy-and-cookie-notice/#copyright"}]}];
---
<SiteFooter variant="grouped" class="site-footer" groups={groups}>
 <Fragment slot="identity"><a class="footer-owner" href="https://jameshoward.us/" aria-label="James Howard website"><img class="footer-owner__badge" src={href('/assets/owner.svg')} alt="" width="58" height="58"/><span class="footer-owner__site">Krigsvold Astro</span><span class="footer-owner__byline">A website of James Howard</span></a><p>Components, working patterns, and agent guidance grounded in krigsvold.org.</p></Fragment>
 <p slot="base">Copyright © 2026 James P. Howard, II</p>
</SiteFooter>
