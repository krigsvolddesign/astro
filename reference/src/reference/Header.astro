---
const {href,current=''}=Astro.props;
const links=[['The Language','/language/'],['Examples','/examples/'],['Journal','/journal/'],['Use This Template','/setup/']];
---
<div class="nav-shell"><div class="container"><nav class="navbar navbar-expand-lg site-navbar mast" aria-label="Primary navigation"><a class="navbar-brand" href={href('/')}><img src={href('/assets/mark.svg')} alt="" width="34" height="34"/><span>Krigsvold Astro</span></a><button class="navbar-toggler nightjar-menu" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu"><span class="navbar-toggler-icon" aria-hidden="true"><span class="navbar-toggler-bar bar1"></span><span class="navbar-toggler-bar bar2"></span><span class="navbar-toggler-bar bar3"></span></span></button><div class="collapse navbar-collapse" id="site-nav"><ul class="navbar-nav ms-auto align-items-lg-center">{links.map(([title,url])=><li class="nav-item"><a class="nav-link" href={href(url)} aria-current={current===url?'page':undefined}>{title}</a></li>)}</ul><button type="button" class="appearance-toggle nightjar-appearance" data-appearance-toggle aria-pressed="false">Dark mode</button></div></nav></div></div>
