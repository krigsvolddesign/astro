---
import { DocumentationLayout, TableOfContents } from '@krigsvold/astro';
import { localPath } from '../paths';
import DemoHead from '../components/DemoHead.astro';
import ReferenceHeader from '../reference/Header.astro';
import ReferenceFooter from '../reference/Footer.astro';
// Optional author-supplied contents: set true only when this document needs them.
const show_toc = false;
---
<DocumentationLayout title="A guide to your project" summary="Documentation with a reading column and optional author-supplied contents." sidebarLabel="Guide contents" bodyClass="krigsvold-source-profile reference-specimen hero-context--compact">
  <DemoHead slot="head"/>
  <ReferenceHeader slot="header" home={localPath('/')} href={localPath}/>

  <TableOfContents slot="contents" label="Manual contents" variant="inline" items={show_toc ? [{href:'#install',label:'Installation'},{href:'#compose',label:'Composition'},{href:'#adapt',label:'Adaptation'}] : []}/>
  <h2 id="install">Installation</h2><pre><code>npm install ./PATH-TO-krigsvold-core.tgz ./PATH-TO-krigsvold-astro.tgz astro</code></pre>
  <h2 id="compose">Composition</h2><p>Set show_toc to true when this document needs manual contents. Explicit contents remain inline above the reading content at every width.</p>
  <h2 id="adapt">Adaptation</h2><p>Use class hooks and namespaced layout variables for deliberate changes. Content, routes, identity, and application behavior remain yours.</p>
  <ReferenceFooter slot="footer" href={localPath}/>
</DocumentationLayout>
