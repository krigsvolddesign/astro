{
  "name": "@krigsvold/astro",
  "version": "1.2.2",
  "description": "Reusable Astro layouts and components for the Krigsvold design system",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "starter",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./Layout.astro": "./src/components/Layout.astro",
    "./Container.astro": "./src/components/Container.astro",
    "./SectionHeading.astro": "./src/components/SectionHeading.astro",
    "./Card.astro": "./src/components/Card.astro",
    "./Button.astro": "./src/components/Button.astro",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json",
    "./Stack.astro": "./src/components/Stack.astro",
    "./Cluster.astro": "./src/components/Cluster.astro",
    "./Grid.astro": "./src/components/Grid.astro",
    "./Sidebar.astro": "./src/components/Sidebar.astro",
    "./Split.astro": "./src/components/Split.astro",
    "./Section.astro": "./src/components/Section.astro",
    "./PageHeader.astro": "./src/components/PageHeader.astro",
    "./SiteHeader.astro": "./src/components/SiteHeader.astro",
    "./SiteFooter.astro": "./src/components/SiteFooter.astro",
    "./ArticleLayout.astro": "./src/components/ArticleLayout.astro",
    "./LandingLayout.astro": "./src/components/LandingLayout.astro",
    "./DocumentationLayout.astro": "./src/components/DocumentationLayout.astro",
    "./TableOfContents.astro": "./src/components/TableOfContents.astro"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.astro"
  ],
  "peerDependencies": {
    "@krigsvold/theme": "^2.2.2",
    "astro": "^5.14.0 || ^6.0.0 || ^7.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krigsvoldtheme/astro.git"
  },
  "homepage": "https://krigsvolddesign.dev/",
  "keywords": [
    "astro",
    "astro-component",
    "krigsvold",
    "theme",
    "design-system"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "playwright": "1.64.1"
  }
}
