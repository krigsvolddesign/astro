---
import Container from './Container.astro';
import Split from './Split.astro';
interface Props { title: string; summary?: string; eyebrow?: string; class?: string; }
const { title, summary, eyebrow, class: className } = Astro.props;
---
<header class:list={['krigsvold-page-header',className]}>
  <Container>
    {Astro.slots.has('media') ? <Split><div class="krigsvold-page-header__copy">{eyebrow && <p class="krigsvold-eyebrow">{eyebrow}</p>}<h1>{title}</h1>{summary && <p class="krigsvold-page-header__summary">{summary}</p>}<div class="krigsvold-page-header__metadata"><slot /></div></div><div slot="secondary" class="krigsvold-page-header__media"><slot name="media" /></div></Split> : <div class="krigsvold-page-header__copy">{eyebrow && <p class="krigsvold-eyebrow">{eyebrow}</p>}<h1>{title}</h1>{summary && <p class="krigsvold-page-header__summary">{summary}</p>}<div class="krigsvold-page-header__metadata"><slot /></div></div>}
  </Container>
</header>
